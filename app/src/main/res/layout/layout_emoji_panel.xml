<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:parentTag="android.widget.LinearLayout">

    <!-- Top Drag Handle (Telegram style expand/collapse bar) -->
    <LinearLayout
        android:id="@+id/layoutDragHandle"
        android:layout_width="match_parent"
        android:layout_height="26dp"
        android:gravity="center"
        android:background="?attr/selectableItemBackground">

        <View
            android:layout_width="38dp"
            android:layout_height="4dp"
            android:background="@drawable/bg_drag_handle" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider_color" />

    <!-- Main Content Container: ViewPager -->
    <androidx.viewpager.widget.ViewPager
        android:id="@+id/viewPagerEmoji"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider_color" />

    <!-- Bottom Tab Navigation Bar (Pinned firmly at the bottom) -->
    <LinearLayout
        android:id="@+id/layoutBottomBar"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="?android:attr/colorBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Tabs Container (Scrollable) -->
        <HorizontalScrollView
            android:id="@+id/scrollTabs"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/layoutTabsContainer"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginVertical="6dp"
            android:background="@color/divider_color" />

        <!-- Delete / Backspace Button -->
        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnBackspace"
            android:layout_width="44dp"
            android:layout_height="match_parent"
            android:background="?attr/selectableItemBackground"
            android:contentDescription="@string/action_delete"
            app:srcCompat="@drawable/ic_back"
            app:tint="?android:attr/textColorSecondary" />

        <!-- Manage / Settings Button -->
        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnManageStickers"
            android:layout_width="44dp"
            android:layout_height="match_parent"
            android:background="?attr/selectableItemBackground"
            android:contentDescription="@string/sticker_manage_title"
            app:srcCompat="@drawable/ic_settings"
            app:tint="?android:attr/textColorSecondary" />
    </LinearLayout>
</merge>
