<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:openDrawer="start">

    <!-- Main Content Area -->
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Toolbar Status Bar Filler -->
            <View
                android:id="@+id/contentStatusBarFiller"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:background="?attr/colorPrimary" />

            <com.google.android.material.appbar.AppBarLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:theme="@style/ThemeOverlay.MaterialComponents.Dark.ActionBar">

                <androidx.appcompat.widget.Toolbar
                    android:id="@+id/toolbar"
                    android:layout_width="match_parent"
                    android:layout_height="?attr/actionBarSize"
                    android:background="?attr/colorPrimary"
                    app:navigationIcon="@drawable/ic_menu"
                    app:title="@string/app_name" />

                <!-- 会话/置顶 Tab 栏 + 搜索框（集成在顶栏内） -->
                <include
                    android:id="@+id/toolbarExtra"
                    layout="@layout/layout_toolbar_home" />

            </com.google.android.material.appbar.AppBarLayout>

            <!-- Fragment Container -->
            <FrameLayout
                android:id="@+id/content_frame"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

        </LinearLayout>

        <!-- Dim Overlay for FAB menu -->
        <View
            android:id="@+id/fabOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#40000000"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone" />

        <!-- Speed Dial FAB Container -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="16dp"
            android:gravity="end"
            android:orientation="vertical">

            <!-- Sub Item 2: New Group -->
            <LinearLayout
                android:id="@+id/layoutSubNewGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:gravity="center_vertical|end"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvSubNewGroupLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_marginRight="8dp"
                    android:background="@drawable/bg_fab_label"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="@string/action_add"
                    android:textColor="@android:color/white"
                    android:textSize="13sp" />

                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/fabSubNewGroup"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:fabSize="mini"
                    app:srcCompat="@drawable/ic_add"
                    app:tint="@android:color/white"
                    app:backgroundTint="@color/app_primary"
                    android:contentDescription="@string/action_add" />
            </LinearLayout>

            <!-- Sub Item 1: New Chat -->
            <LinearLayout
                android:id="@+id/layoutSubNewChat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:gravity="center_vertical|end"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvSubNewChatLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_marginRight="8dp"
                    android:background="@drawable/bg_fab_label"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="@string/fab_new_chat"
                    android:textColor="@android:color/white"
                    android:textSize="13sp" />

                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/fabSubNewChat"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:fabSize="mini"
                    app:srcCompat="@drawable/ic_chat"
                    app:tint="@android:color/white"
                    app:backgroundTint="@color/app_primary"
                    android:contentDescription="@string/fab_new_chat" />
            </LinearLayout>

            <!-- Main FAB -->
            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fabAdd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:srcCompat="@drawable/ic_add"
                app:tint="@color/text_white"
                app:backgroundTint="@color/app_primary"
                android:contentDescription="@string/fab_new_chat" />

        </LinearLayout>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <!-- Drawer Sidebar -->
    <LinearLayout
        android:id="@+id/nav_view"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="?android:attr/windowBackground"
        android:orientation="vertical">

        <!-- Sidebar Status Bar Filler -->
        <View
            android:id="@+id/sidebarStatusBarFiller"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:background="?attr/colorPrimary" />

        <!-- User Info Header -->
        <LinearLayout
            android:id="@+id/layoutUserHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/colorPrimary"
            android:foreground="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:orientation="horizontal"
            android:padding="16dp"
            android:gravity="center_vertical">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivAvatar"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Circle"
                app:srcCompat="@android:drawable/sym_def_app_icon"
                app:strokeColor="@color/text_white"
                app:strokeWidth="2dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:layout_marginLeft="16dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvUsername"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_white"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    tools:text="Username" />

                <TextView
                    android:id="@+id/tvUserId"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/text_white_secondary"
                    android:textSize="12sp"
                    tools:text="ID: 12345" />
            </LinearLayout>
        </LinearLayout>

        <!-- Middle Menu Items -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout android:id="@+id/menu_conversations" style="@style/MenuButtonStyle">
                    <androidx.appcompat.widget.AppCompatImageView style="@style/MenuIconStyle" app:srcCompat="@drawable/ic_chat" />
                    <TextView style="@style/MenuTextStyle" android:text="@string/menu_conversations" />
                </LinearLayout>

                <LinearLayout android:id="@+id/menu_address_book" style="@style/MenuButtonStyle">
                    <androidx.appcompat.widget.AppCompatImageView style="@style/MenuIconStyle" app:srcCompat="@drawable/ic_contacts" />
                    <TextView style="@style/MenuTextStyle" android:text="@string/menu_address_book" />
                </LinearLayout>

                <LinearLayout android:id="@+id/menu_community" style="@style/MenuButtonStyle">
                    <androidx.appcompat.widget.AppCompatImageView style="@style/MenuIconStyle" app:srcCompat="@drawable/ic_group" />
                    <TextView style="@style/MenuTextStyle" android:text="@string/menu_community" />
                </LinearLayout>

                <LinearLayout android:id="@+id/menu_discovery" style="@style/MenuButtonStyle">
                    <androidx.appcompat.widget.AppCompatImageView style="@style/MenuIconStyle" app:srcCompat="@drawable/ic_explore" />
                    <TextView style="@style/MenuTextStyle" android:text="@string/menu_discovery" />
                </LinearLayout>

                <!-- 侧边栏语音播放卡片 -->
                <LinearLayout
                    android:id="@+id/layoutVoiceCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="12dp"
                    android:background="@drawable/bg_voice_card"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="10dp"
                    android:visibility="gone">

                    <!-- 播放/暂停按钮 -->
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/ivDrawerVoicePlayPause"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:padding="2dp"
                        app:srcCompat="@drawable/ic_play"
                        app:tint="@color/text_white" />

                    <!-- 中间进度与时间 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_marginLeft="8dp"
                        android:layout_marginEnd="8dp"
                        android:layout_marginRight="8dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <com.nago8.chat.old.widget.VoiceProgressSlider
                            android:id="@+id/drawerVoiceSlider"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvDrawerVoiceTime"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:textColor="@color/text_white"
                                android:textSize="11sp"
                                android:alpha="0.85" />

                            <TextView
                                android:id="@+id/tvDrawerVoiceTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/message_voice"
                                android:textColor="@color/text_white"
                                android:textSize="11sp"
                                android:alpha="0.65" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- 右侧关闭按钮 -->
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/ivDrawerVoiceClose"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:padding="4dp"
                        app:srcCompat="@drawable/ic_close"
                        app:tint="@color/text_white" />
                </LinearLayout>

            </LinearLayout>
        </ScrollView>

        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider_color" />

        <!-- Bottom Menu Items -->
        <LinearLayout android:id="@+id/menu_settings" style="@style/MenuButtonStyle">
            <androidx.appcompat.widget.AppCompatImageView style="@style/MenuIconStyle" app:srcCompat="@drawable/ic_settings" />
            <TextView style="@style/MenuTextStyle" android:text="@string/menu_settings" />
        </LinearLayout>

        <LinearLayout android:id="@+id/menu_language" style="@style/MenuButtonStyle">
            <androidx.appcompat.widget.AppCompatImageView style="@style/MenuIconStyle" app:srcCompat="@drawable/ic_language" />
            <TextView style="@style/MenuTextStyle" android:text="@string/menu_language" />
        </LinearLayout>

        <LinearLayout android:id="@+id/menu_logout" style="@style/MenuButtonStyle">
            <androidx.appcompat.widget.AppCompatImageView style="@style/MenuIconStyle" app:srcCompat="@drawable/ic_logout" />
            <TextView style="@style/MenuTextStyle" android:text="@string/menu_logout" />
        </LinearLayout>

    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>
