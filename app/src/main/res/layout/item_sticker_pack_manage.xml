<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="4dp"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="12dp"
    app:cardElevation="1dp"
    app:strokeColor="@color/divider_color"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <!-- Cover Image -->
        <ImageView
            android:id="@+id/ivPackCover"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter" />

        <!-- Info Column -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginLeft="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvPackName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/bubble_text_left"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvPackCount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Up / Down Reorder Buttons -->
        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnMoveUp"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_move_up"
            app:srcCompat="@drawable/ic_back"
            android:rotation="90"
            app:tint="?android:attr/textColorSecondary" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnMoveDown"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_move_down"
            app:srcCompat="@drawable/ic_back"
            android:rotation="270"
            app:tint="?android:attr/textColorSecondary" />

        <!-- Remove Button -->
        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnRemovePack"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/sticker_remove_pack"
            app:srcCompat="@drawable/ic_delete_bin"
            app:tint="#FFE53935" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
